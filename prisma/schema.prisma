generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String              @id @default(cuid())
  name                   String?
  email                  String              @unique
  phone                  String?             @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  role                   Role                @default(STUDENT)
  plan                   Plan                @default(FREE)
  onboardedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  accounts               Account[]
  triggeredNotifications AdminNotification[] @relation("NotificationTriggeredBy")
  examSessions           ExamSession[]
  imports                Import[]
  questionFlags          QuestionFlag[]
  reviewedContent        Question[]          @relation("ReviewedBy")
  sessions               Session[]
  studentProfile         StudentProfile?
  generatedTokens        AccessToken[]       @relation("GeneratedTokens")
  redeemedToken          AccessToken?        @relation("RedeemedToken")
  authoredBlogPosts      BlogPost[]          @relation("AuthoredBlogPosts")
  liveSessions           LiveSession[]       @relation("CreatedLiveSessions")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model AccessToken {
  id            String    @id @default(cuid())
  code          String    @unique
  note          String?
  generatedById String
  usedById      String?   @unique
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  generatedBy User  @relation("GeneratedTokens", fields: [generatedById], references: [id], onDelete: Cascade)
  usedBy      User? @relation("RedeemedToken", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([generatedById])
  @@map("access_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model StudentProfile {
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  age                       Int?
  targetYear                Int?
  courseChoice              String?
  institution               String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  avatarConfig              Json?
  avatarUrl                 String?
  courseSubjectCombinations CourseSubjectCombination[]
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Subject {
  id                        String                     @id @default(cuid())
  name                      String                     @unique
  code                      String                     @unique
  description               String?
  isActive                  Boolean                    @default(true)
  sortOrder                 Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  courseSubjectCombinations CourseSubjectCombination[]
  examTemplateSubjects      ExamTemplateSubject[]
  questions                 Question[]
  topics                    Topic[]

  @@index([isActive])
  @@map("subjects")
}

model Topic {
  id          String     @id @default(cuid())
  subjectId   String
  name        String
  description String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name])
  @@index([subjectId])
  @@index([isActive])
  @@map("topics")
}

model Question {
  id                   String                @id @default(cuid())
  subjectId            String
  topicId              String?
  proseTextId          String?
  text                 String
  year                 Int?
  difficulty           Difficulty            @default(MEDIUM)
  sourceType           SourceType            @default(MANUAL)
  sourceRef            String?
  isPublished          Boolean               @default(false)
  aiAssisted           Boolean               @default(false)
  reviewedAt           DateTime?
  reviewedById         String?
  importId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  flagCount            Int                   @default(0)
  isFlagged            Boolean               @default(false)
  imageUrl             String?
  examType             ExamType?
  school               String?
  adminNotifications   AdminNotification[]
  examSessionQuestions ExamSessionQuestion[]
  explanation          Explanation?
  questionFlags        QuestionFlag[]
  options              QuestionOption[]
  import               Import?               @relation(fields: [importId], references: [id])
  proseText            ProseText?            @relation(fields: [proseTextId], references: [id])
  reviewedBy           User?                 @relation("ReviewedBy", fields: [reviewedById], references: [id])
  subject              Subject               @relation(fields: [subjectId], references: [id])
  topic                Topic?                @relation(fields: [topicId], references: [id])
  userAnswers          UserAnswer[]

  @@index([subjectId])
  @@index([topicId])
  @@index([isPublished])
  @@index([isFlagged])
  @@index([year])
  @@index([subjectId, year])
  @@index([subjectId, isPublished])
  @@index([subjectId, year, isPublished])
  @@index([topicId, isPublished])
  @@index([examType])
  @@index([school, examType])
  @@index([school, examType, year])
  @@index([school])
  @@map("questions")
}

model QuestionOption {
  id          String       @id @default(cuid())
  questionId  String
  label       String
  text        String
  isCorrect   Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model Explanation {
  id         String   @id @default(cuid())
  questionId String   @unique
  text       String
  aiAssisted Boolean  @default(false)
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("explanations")
}

model ProseText {
  id          String         @id @default(cuid())
  title       String         @unique
  author      String?
  year        Int?
  summary     String?
  themes      String?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sections    ProseSection[]
  questions   Question[]

  @@map("prose_texts")
}

model ProseSection {
  id          String    @id @default(cuid())
  proseTextId String
  title       String
  content     String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  proseText   ProseText @relation(fields: [proseTextId], references: [id], onDelete: Cascade)

  @@index([proseTextId])
  @@map("prose_sections")
}

model ExamTemplate {
  id              String                @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int                   @default(120)
  totalQuestions  Int                   @default(40)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  examSessions    ExamSession[]
  subjects        ExamTemplateSubject[]

  @@map("exam_templates")
}

model ExamTemplateSubject {
  id             String       @id @default(cuid())
  examTemplateId String
  subjectId      String
  questionCount  Int          @default(10)
  examTemplate   ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id])

  @@unique([examTemplateId, subjectId])
  @@map("exam_template_subjects")
}

model ExamSession {
  id              String                @id @default(cuid())
  userId          String
  examTemplateId  String?
  liveSessionId   String?
  mode            ExamMode              @default(MOCK)
  subjectId       String?
  topicId         String?
  status          ExamStatus            @default(IN_PROGRESS)
  startedAt       DateTime              @default(now())
  submittedAt     DateTime?
  expiresAt       DateTime?
  durationMinutes Int                   @default(120)
  totalQuestions  Int
  currentQuestion Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  school          String?
  questions       ExamSessionQuestion[]
  examTemplate    ExamTemplate?         @relation(fields: [examTemplateId], references: [id])
  liveSession     LiveSession?          @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  result          Result?
  userAnswers     UserAnswer[]

  @@unique([liveSessionId, userId])
  @@index([userId])
  @@index([userId, status])
  @@map("exam_sessions")
}

// ─── Live Sessions ───────────────────────────────────────────────────────────
// A teacher-created, timed mock practice that students join via a short code.
// It is a *configuration envelope*: each joining student forks a normal
// ExamSession (tagged with liveSessionId), so all existing exam logic runs unchanged.
model LiveSession {
  id              String            @id @default(cuid())
  code            String            @unique
  title           String?
  status          LiveSessionStatus @default(SCHEDULED)
  mode            ExamMode          @default(MOCK)
  subjectIds      String[]
  durationMinutes Int               @default(60)
  questionCount   Int               @default(40)
  createdById     String
  endsAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  createdBy    User          @relation("CreatedLiveSessions", fields: [createdById], references: [id], onDelete: Cascade)
  examSessions ExamSession[]

  @@index([createdById])
  @@index([status])
  @@map("live_sessions")
}

model ExamSessionQuestion {
  id            String      @id @default(cuid())
  examSessionId String
  questionId    String
  position      Int
  markedReview  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  examSession   ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])

  @@unique([examSessionId, questionId])
  @@index([examSessionId])
  @@map("exam_session_questions")
}

model UserAnswer {
  id            String          @id @default(cuid())
  examSessionId String
  questionId    String
  optionId      String?
  isCorrect     Boolean?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  examSession   ExamSession     @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  option        QuestionOption? @relation(fields: [optionId], references: [id])
  question      Question        @relation(fields: [questionId], references: [id])

  @@unique([examSessionId, questionId])
  @@index([examSessionId])
  @@map("user_answers")
}

model Result {
  id                String                   @id @default(cuid())
  examSessionId     String                   @unique
  userId            String
  totalQuestions    Int
  correct           Int
  incorrect         Int
  unanswered        Int
  score             Float
  subjectBreakdown  Json                     @default("{}")
  topicBreakdown    Json                     @default("{}")
  createdAt         DateTime                 @default(now())
  subjectBreakdowns ResultSubjectBreakdown[]
  topicBreakdowns   ResultTopicBreakdown[]
  examSession       ExamSession              @relation(fields: [examSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("results")
}

model ResultSubjectBreakdown {
  id        String @id @default(cuid())
  resultId  String
  subjectId String
  name      String
  correct   Int
  total     Int
  result    Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, subjectId])
  @@index([resultId])
  @@index([subjectId])
  @@map("result_subject_breakdowns")
}

model ResultTopicBreakdown {
  id       String @id @default(cuid())
  resultId String
  topicId  String
  name     String
  correct  Int
  total    Int
  result   Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, topicId])
  @@index([resultId])
  @@index([topicId])
  @@map("result_topic_breakdowns")
}

model CourseSubjectCombination {
  id               String         @id @default(cuid())
  studentProfileId String
  subjectId        String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id])

  @@unique([studentProfileId, subjectId])
  @@map("course_subject_combinations")
}

model Import {
  id            String       @id @default(cuid())
  uploadedById  String
  filename      String
  format        ImportFormat @default(CSV)
  status        ImportStatus @default(PENDING)
  totalRows     Int          @default(0)
  validRows     Int          @default(0)
  invalidRows   Int          @default(0)
  publishedRows Int          @default(0)
  errorLog      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  questions     Question[]

  @@index([uploadedById])
  @@map("imports")
}

model AdminActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String?
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

model QuestionFlag {
  id         String    @id @default(cuid())
  questionId String
  userId     String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId])
  @@index([questionId])
  @@map("question_flags")
}

model AdminNotification {
  id            String    @id @default(cuid())
  type          String
  questionId    String?
  triggeredById String?
  message       String
  read          Boolean   @default(false)
  createdAt     DateTime  @default(now())
  question      Question? @relation(fields: [questionId], references: [id])
  triggeredBy   User?     @relation("NotificationTriggeredBy", fields: [triggeredById], references: [id])

  @@index([read])
  @@index([createdAt])
  @@map("admin_notifications")
}

enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SourceType {
  MANUAL
  IMPORTED
  AI_ASSISTED
}

enum ExamMode {
  MOCK
  PRACTICE
  TOPIC
  POST_UTME
}

enum ExamStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  ABANDONED
}

enum LiveSessionStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum ImportFormat {
  CSV
  JSON
}

enum ImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ExamType {
  JAMB
  WAEC
  POST_UTME
}

enum Plan {
  FREE
  PREMIUM
}

model SiteVisit {
  date  DateTime @id @db.Date
  count Int      @default(0)

  @@map("site_visits")
}

// Global key-value store for admin-controlled platform settings (e.g. which
// exam groups are currently open for students). One row per setting key; the
// value is JSON so a single table serves many small toggles without migrations.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

enum BlogCategory {
  UTME
  POST_UTME
  JAMB
  SCHOOL_NEWS
  STUDY_TIPS
  SCHOLARSHIPS
  CAREER
  ANNOUNCEMENT
  GENERAL
}

model BlogPost {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?
  category      BlogCategory @default(GENERAL)
  authorId      String
  publishedAt   DateTime?
  notifiedAt    DateTime?
  viewCount     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  author User @relation("AuthoredBlogPosts", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([category, publishedAt])
  @@map("blog_posts")
}

// ─── Mock Exam (standalone, no FK into users) ─────────────────────────────────

model MockExam {
  id              String   @id @default(cuid())
  slug            String?  @unique
  title           String
  description     String?  @db.Text
  startsAt        DateTime
  endsAt          DateTime
  durationMinutes Int      @default(60)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions    MockExamQuestion[]
  participants MockExamParticipant[]
  sessions     MockExamSession[]
  panicReports MockPanicReport[]

  @@map("mock_exams")
}

model MockExamQuestion {
  id          String   @id @default(cuid())
  mockExamId  String
  text        String   @db.Text
  imageUrl    String?  @db.Text
  options     Json
  subject     String
  explanation String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  mockExam MockExam         @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  answers  MockExamAnswer[]

  @@index([mockExamId])
  @@map("mock_exam_questions")
}

model MockExamParticipant {
  id           String   @id @default(cuid())
  mockExamId   String
  phone        String
  name         String?
  pinHash      String?
  avatarConfig Json?
  avatarUrl    String?  @db.Text
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  mockExam     MockExam          @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  sessions     MockExamSession[]
  panicReports MockPanicReport[]

  @@unique([mockExamId, phone])
  @@index([mockExamId])
  @@map("mock_exam_participants")
}

model MockExamSession {
  id            String            @id @default(cuid())
  mockExamId    String
  participantId String
  attemptNumber Int               @default(1)
  status        MockSessionStatus @default(IN_PROGRESS)
  startedAt     DateTime          @default(now())
  submittedAt   DateTime?
  score         Float?
  correct       Int?
  total         Int?
  // Subject strings this attempt covers (compulsory + chosen electives).
  // Empty = legacy session created before per-subject selection; treat as "all".
  subjects      String[]          @default([])

  mockExam     MockExam            @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  participant  MockExamParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  answers      MockExamAnswer[]
  panicReports MockPanicReport[]

  @@unique([participantId, attemptNumber])
  @@index([mockExamId])
  @@index([participantId])
  @@map("mock_exam_sessions")
}

model MockExamAnswer {
  id         String   @id @default(cuid())
  sessionId  String
  questionId String
  selected   String?
  isCorrect  Boolean?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  MockExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question MockExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("mock_exam_answers")
}

model MockPanicReport {
  id            String   @id @default(cuid())
  mockExamId    String
  participantId String
  sessionId     String?
  message       String   @db.Text
  isResolved    Boolean  @default(false)
  createdAt     DateTime @default(now())

  mockExam    MockExam            @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  participant MockExamParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     MockExamSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([mockExamId, isResolved])
  @@index([participantId])
  @@map("mock_panic_reports")
}

enum MockSessionStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
}
