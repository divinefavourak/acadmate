# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
API_URL="http://localhost:3001"

# ─── Email (Gmail API) ────────────────────────────────────────────────────────
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from OAuth above.
# Get GMAIL_REFRESH_TOKEN via OAuth Playground (https://developers.google.com/oauthplayground)
# with scope https://www.googleapis.com/auth/gmail.send, using your own OAuth credentials.
GMAIL_USER="acadmatebc@gmail.com"
GMAIL_REFRESH_TOKEN=""
SMTP_FROM="Acadmate <acadmatebc@gmail.com>"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
